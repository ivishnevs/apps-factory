{
  "launch": {
    "spec": {
      "id": "run-resume",
      "project": "demo",
      "agent": "claude-demo",
      "provider": "claude",
      "workspace": "/tmp/factory/demo",
      "prompt": "Continue where you stopped.",
      "instructions": "You are the demo developer agent.",
      "timeout_seconds": 600,
      "runtime_options": {
        "model": "default"
      },
      "session_id": "0b9e4d27-8c51-4f3a-b6e2-7d18a5c94e60"
    },
    "cwd": "/tmp/factory/demo",
    "instructions": "You are the demo developer agent.\nUse the factory MCP server for project data and exits.",
    "mcp_command": "/opt/factory/bin/factory-mcp"
  },
  "env": {
    "PATH": "/usr/bin:/bin",
    "HOME": "/Users/factory",
    "FACTORY_URL": "http://127.0.0.1:8080",
    "FACTORY_RUN_TOKEN": "frt_resume"
  },
  "account": {
    "email": "owner@example.com",
    "subscriptionType": "max",
    "tokenSource": "claude.ai",
    "apiKeySource": "none",
    "apiProvider": "firstParty"
  },
  "mcp_status": [
    "connected"
  ]
}
