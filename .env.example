FACTORY_TOKEN=replace-with-random-hex
NATS_PASSWORD=replace-with-random-hex
POSTGRES_PASSWORD=replace-with-random-hex

# Optional: the company this Core serves (catalog configs/<company>/; default: the configs/ tree).
# FACTORY_COMPANY=default

# Optional: Telegram bot for owner attention items (docs/messaging.md#telegram).
# FACTORY_TELEGRAM_TOKEN=
# FACTORY_TELEGRAM_PROJECT=
# FACTORY_TELEGRAM_DIGEST_AT=18:00

# Optional: website sign-in (user-accounts; docs/development.md#sign-in). Dex runs in compose; set the issuer to
# turn sign-in on. FACTORY_OIDC_CLIENT_SECRET is shared by Dex and Core (random, e.g. openssl rand -hex 32).
# FACTORY_OIDC_ISSUER=http://127.0.0.1:5556/dex
# FACTORY_OIDC_CLIENT_SECRET=replace-with-random-hex
# FACTORY_OIDC_PROVIDERS=google,github        # sign-in buttons (Dex connector ids); mock for local development
# FACTORY_PUBLIC_URL=http://127.0.0.1:3000    # the web UI's address; https turns on Secure cookies
# DEX_MOCK_CONNECTOR=1                        # local development: a "Test user" button, no external account
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   # OAuth app, redirect URI <issuer>/callback
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=   # OAuth app, callback URL <issuer>/callback
# FACTORY_MULTI_COMPANY=0                     # 1: users may create more companies (selector in the web UI)
